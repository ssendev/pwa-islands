{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "repos/",
    "foldkitapp/**",
    "**/*.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "**/*.config.js",
    "**/*.config.mjs"
  ],
  "env": {
    "builtin": true
  }
}
