{
  "name": "pwa-islands",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/sync-version.mjs && tauri build",
    "version:sync": "node scripts/sync-version.mjs",
    "version:restore": "node scripts/sync-version.mjs --restore",
    "dev": "vite",
    "build": "vite build",
    "build:downloads": "node scripts/prepare-downloads.mjs",
    "build:android": "scripts/build-android.sh",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "test": "vitest run",
    "lint": "oxlint src && npm run -s patch:effect && oxlint --config .oxlintrc.effect.json --deny-warnings src",
    "patch:effect": "effect-tsgo patch --no-typescript --oxlint &>/dev/null || effect-tsgo patch --no-typescript --oxlint",
    "fix": "npm run -s format && npm run -s lint && npm run -s typecheck",
    "update:vendored-foldkit": "scripts/update-vendored-foldkit.sh"
  },
  "dependencies": {
    "@effect/platform-browser": "^4.0.0",
    "@foldkit/ui": "^0.169.0",
    "@tauri-apps/api": "^2.12.4",
    "effect": "^4.0.0",
    "foldkit": "^0.169.0"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.56.0",
    "@foldkit/devtools": "^0.169.0",
    "@foldkit/devtools-mcp": "^0.25.0",
    "@foldkit/oxlint-plugin": "^0.15.3",
    "@foldkit/vite-plugin": "^0.28.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "happy-dom": "^20.14.6",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
